# =========================================
# 카톡 방장 비서 MVP - 환경 변수
# 사용법:
#   1) 이 파일을 `.env` 로 복사
#   2) OPENAI_API_KEY 에 본인 키 입력 (sk-... 로 시작)
#   3) 브라우저에서 http://localhost:8765 접속하면 자동 로드됨
#
# ⚠️ 보안 주의
#   - 이 앱은 정적 HTML/JS 라 브라우저에서 fetch('/.env') 로 키를 읽음.
#   - 즉, 로컬 서버에 접근 가능한 누구든 키를 볼 수 있음.
#   - 로컬 개발 용도로만 사용하세요. 외부 노출 금지.
#   - .env 는 .gitignore 에 포함되어 있어 커밋되지 않습니다.
# =========================================

# OpenAI API 키 (필수)
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# 사용할 모델 (선택, 기본값: gpt-5-mini)
# 옵션: gpt-5-mini | gpt-4o-mini
OPENAI_MODEL=gpt-5-mini
